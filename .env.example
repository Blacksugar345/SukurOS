# Supabase Configuration (Required by @nuxtjs/supabase)
# Replace with your actual Supabase project URL and keys
NUXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NUXT_PUBLIC_SUPABASE_KEY="your-supabase-anon-public-key-placeholder"

# Legacy / Fallback Variable Names
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-anon-public-key-placeholder"

# Optional Server-only Secret Key (Never exposed to client)
NUXT_SUPABASE_SECRET_KEY="your-supabase-service-role-secret-key-placeholder"
